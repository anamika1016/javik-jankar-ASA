# Rails runtime files. Keep directory placeholders, never generated contents.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Gems installed locally or on a deployment host.
/vendor/bundle/

# Local environment and database files.
/.env*
!/\.env.example
/storage/*
!/storage/.keep

# OS/editor files.
.DS_Store
*.swp
*~

# Precompiled assets. The server builds its own on deploy.
/public/assets

# Runtime uploads belong to storage/production, never to a source commit.
# Existing tracked reference assets remain tracked; this prevents only new
# CSV/XLSX/image uploads from appearing in `git status`.
/public/uploads/module_records/*
!/public/uploads/module_records/.keep

# Firebase service account key -- never commit this.
config/fcm-service-account.json
