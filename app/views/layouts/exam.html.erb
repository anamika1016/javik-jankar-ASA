<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "JJ Exam" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="jj-exam-public-body">
    <% if notice.present? %>
      <div class="jj-exam-flash notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="jj-exam-flash alert"><%= alert %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
