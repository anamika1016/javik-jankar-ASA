<div class="bill-farmer-list">
  <% farmers.each do |farmer| %>
    <div class="bill-farmer-card">
      <strong><%= farmer["name"].presence || "Name unavailable" %></strong>
      <p>Village: <%= farmer["village_name"].presence || item["village"].presence || "-" %> | Father: <%= farmer["father_name"].presence || "-" %> | Tracenet: <%= farmer["tracenet_no"].presence || "-" %></p>
    </div>
  <% end %>
  <% if farmers.empty? %>
    <p class="bill-farmer-empty">No farmers in this list.</p>
  <% end %>
</div>
