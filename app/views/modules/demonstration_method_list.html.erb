<%= javascript_import_module_tag "dashboard_reports" %>
<% content_for :title, "Demonstration Method View List" %>
<section class="dashboard-page" data-dashboard-report>
  <div class="dashboard-topbar">
    <h1>Demonstration Method View List</h1>
    <div class="dashboard-actions">
      <%= link_to "Back to Dashboard", dashboard_path(request.query_parameters.except("format", "demonstration_list")), class: "list-btn active" %>
      <%= link_to "Export Excel", demonstration_method_list_path(request.query_parameters.merge(format: :xlsx)), class: "list-btn export", data: { report_export: true } %>
    </div>
  </div>
  <section class="module-card">
    <%= render "dashboard_report_filters" %>
    <p>Total: <%= @demonstration_method_rows.size %></p>
    <%= render "demonstration_method_table", headers: DashboardDemonstrationMethodReport::HEADERS, rows: @demonstration_method_rows %>
  </section>
</section>
