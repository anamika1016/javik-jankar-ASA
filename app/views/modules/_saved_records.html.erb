      <% saved_record_fields = @module[:fields].reject { |field| field == "Status" } %>
      <% full_saved_record_slugs = ["state-master", "district-master", "block-master", "gram-panchayat-master", "village-master", "person-type"] %>
      <% saved_record_fields = saved_record_fields.first(4) unless full_saved_record_slugs.include?(@slug) || @slug == "jeevika-jankar-transfer-list" %>
      <% server_paginated_master_list = defined?(@module_records_total_count) %>
      <% saved_records_url = ->(**options) { @record.present? ? edit_module_record_path(@slug, @record, **options) : module_path(@slug, **options) } %>
      <% if server_paginated_master_list %><turbo-frame id="module_saved_records_page" target="_top"><% end %>
      <section class="module-card">
        <div class="module-card-header">
          <h2>Saved Records</h2>
          <span class="record-count"><%= server_paginated_master_list ? @module_records_total_count : @records.size %> records</span>
        </div>
        <div class="list-controls">
          <% if server_paginated_master_list %>
            <%= form_with url: saved_records_url.call, method: :get, local: true, class: "list-search", data: { turbo_frame: "module_saved_records_page" } do %>
              <span>⌕</span>
              <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search records">
            <% end %>
          <% else %>
            <div class="list-search">
              <span>⌕</span>
              <input type="search" placeholder="Search records" data-table-search="module_saved_records">
            </div>
          <% end %>
          <%= form_with url: import_module_path(@slug), method: :post, multipart: true, local: true, class: "list-control-actions" do |form| %>
            <label class="import-btn">
              Choose Excel
              <%= form.file_field :file, accept: ".csv,.xlsx", data: { import_file: true }, hidden: true %>
            </label>
            <%= form.submit "Upload", class: "list-btn upload" %>
            <%= link_to "Export Excel", export_module_path(@slug, format: :xlsx), class: "list-btn export" %>
          <% end %>
        </div>
        <div class="table-shell">
          <table class="module-table" id="module_saved_records"<%= " data-paginated-table data-page-size=15" unless server_paginated_master_list %>>
            <thead>
              <tr>
                <% saved_record_fields.each do |field| %>
                  <th><%= resource_person_label(field) %></th>
                <% end %>
                <th>Saved At</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if @records.any? %>
                <% @records.each do |record| %>
                  <tr>
                    <% saved_record_fields.each do |field| %>
                      <td><%= module_record_field_value(record, field).presence || "-" %></td>
                    <% end %>
                    <td><%= record.created_at&.strftime("%d-%m-%Y %I:%M %p") %></td>
                    <td><span class="status-pill <%= record.data["status"] == "Inactive" ? "inactive" : "active" %>"><%= record.data["status"].presence || "Active" %></span></td>
                    <td>
                      <div class="table-actions">
                        <%= link_to "Edit", edit_module_record_path(@slug, record), class: "table-action" %>
                        <%# See the master-table note above: method links retain the
                            same routes/actions while avoiding two forms per row. %>
                        <%= link_to(record.data["status"] == "Inactive" ? "Activate" : "Deactivate", toggle_module_record_path(@slug, record), class: "table-action", data: { turbo_method: :patch }) %>
                        <%= link_to "Delete", module_record_path(@slug, record), class: "table-action danger", data: { turbo_method: :delete, turbo_confirm: "Delete this record?" } %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="<%= saved_record_fields.size + 3 %>">No records saved yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if server_paginated_master_list %>
          <% if @module_records_page_count > 1 %>
            <nav class="table-pagination" aria-label="Saved record pages">
              <% if @module_records_page > 1 %>
                <%= link_to "Previous", saved_records_url.call(page: @module_records_page - 1, q: params[:q].presence), class: "page-link", data: { turbo_frame: "module_saved_records_page" } %>
              <% end %>
              <span>Page <%= @module_records_page %> of <%= @module_records_page_count %></span>
              <% if @module_records_page < @module_records_page_count %>
                <%= link_to "Next", saved_records_url.call(page: @module_records_page + 1, q: params[:q].presence), class: "page-link", data: { turbo_frame: "module_saved_records_page" } %>
              <% end %>
            </nav>
          <% end %>
        <% else %>
          <div class="table-pagination" data-pagination-for="module_saved_records"></div>
        <% end %>
      </section>
      <% if server_paginated_master_list %></turbo-frame><% end %>
