<% content_for :title, "CC and JJ Work Status View List" %>
<section class="dashboard-page">
  <div class="dashboard-topbar">
    <h1>CC and JJ Work Status View List</h1>
    <div class="dashboard-actions">
      <%= link_to "Back to Dashboard", dashboard_path(request.query_parameters.except("format", "work_status_list")), class: "list-btn active" %>
      <%= link_to "Export Excel", cc_jj_work_status_list_path(request.query_parameters.merge(format: :xlsx)), class: "list-btn export" %>
    </div>
  </div>
  <section class="module-card">
    <p>JJ and cluster-incharge names use the selected month’s target mapping, or the saved farmer-to-JJ assignment when no monthly mapping exists. Status counts remain month-specific.</p>
    <p>Total: <%= @work_status_rows.size %></p>
    <%= render "demonstration_method_table", headers: CcJjWorkStatusReport::HEADERS, rows: @work_status_rows %>
  </section>
</section>
