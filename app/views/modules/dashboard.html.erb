<% content_for :title, "Dashboard" %>

<% if @vrp_dashboard %>
  <% quantity = ->(value) { value.to_f == value.to_i ? value.to_i : format("%.2f", value.to_f) } %>
  <section class="dashboard-page">
    <div class="dashboard-topbar">
      <div>
        <p class="vrp-eyebrow">VRP Dashboard</p>
        <h1><%= @vrp&.name.presence || current_app_user["name"].presence || "Dashboard" %></h1>
        <p>Your mapped farmers, villages, assigned targets, and completed work summary.</p>
      </div>

      <div class="dashboard-actions">
        <div class="dashboard-header-clock" aria-label="Live Clock">
          <span>Live</span>
          <strong data-dashboard-clock-time><%= @dashboard_generated_at.strftime("%I:%M:%S %p") %></strong>
          <small data-dashboard-clock-date><%= @dashboard_generated_at.strftime("%d %b %Y") %></small>
        </div>
        <%= link_to "Participation Report", farmer_participation_report_path, class: "list-btn" %>
        <%= link_to "View Targets", target_mappings_path, class: "list-btn active" %>
      </div>
    </div>

    <% dashboard_cards_by_title = @dashboard_cards.index_by { |card| card[:title] } %>
    <section class="module-card vrp-work-overview">
      <div class="vrp-work-overview-header">
        <div>
          <h2>Work Overview</h2>
          <p><%= @training_selected_month %> assigned work area and target progress.</p>
        </div>
        <div class="dashboard-actions">
          <%= form_with url: dashboard_path, method: :get, local: true do |form| %>
            <%= form.label :training_month, "Month" %>
            <%= form.select :training_month,
                  options_for_select(@training_month_options.map { |month| [month, month] }, @training_selected_month),
                  {},
                  onchange: "this.form.submit()" %>
          <% end %>
          <span>Click any number to open its monthly detailed list</span>
        </div>
      </div>
      <div class="vrp-work-overview-metrics">
        <% ["Mapped Farmers", "Mapped Villages", "Main Activities", "Sub Activities", "Assigned Target", "Achieved Target", "Pending Target"].each do |title| %>
          <% card = dashboard_cards_by_title[title] %>
          <%= link_to card[:path], class: "#{title.parameterize}", title: card[:caption], data: { dashboard_card: true } do %>
            <span><%= title %></span>
            <strong><%= card[:value] %></strong>
            <small><%= card[:caption] %></small>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="module-card" id="vrp_target_progress">
      <div class="module-card-header">
        <h2>Assigned Target Progress</h2>
        <button type="button" class="list-btn export" data-export-table="vrp_target_progress_table">Export</button>
      </div>

      <div class="table-shell">
        <table class="module-table compact-table" id="vrp_target_progress_table" data-paginated-table data-page-size="15">
          <thead>
            <tr>
              <th>Month</th>
              <th>Completion Date</th>
              <th>FCO</th>
              <th>Village</th>
              <th>Farmers</th>
              <th>Main Activity</th>
              <th>Sub Activity</th>
              <th>Target</th>
              <th>Week 1</th>
              <th>Week 2</th>
              <th>Week 3</th>
              <th>Week 4</th>
              <th>OPG Training</th>
              <th>General Training/Meeting</th>
              <th>Input Demo INM</th>
              <th>Input Demo PM</th>
              <th>FFS</th>
              <th>Completed</th>
              <th>Pending</th>
              <th>Progress</th>
            </tr>
          </thead>
          <tbody>
            <% if @vrp_target_rows.any? %>
              <% @vrp_target_rows.each do |row| %>
                <tr>
                  <td><%= row[:month] %></td>
                  <td><%= row[:completion_date].presence || "-" %></td>
                  <td><%= row[:fco] %></td>
                  <td><%= row[:village] %></td>
                  <td><%= row[:farmers] %></td>
                  <td><%= row[:main_activity] %></td>
                  <td><%= row[:activity] %></td>
                  <td><%= quantity.call(row[:target]) %></td>
                  <td><%= quantity.call(row[:week_1]) %></td>
                  <td><%= quantity.call(row[:week_2]) %></td>
                  <td><%= quantity.call(row[:week_3]) %></td>
                  <td><%= quantity.call(row[:week_4]) %></td>
                  <td><%= row[:opg_training].present? ? quantity.call(row[:opg_training]) : "-" %></td>
                  <td><%= row[:general_training].present? ? quantity.call(row[:general_training]) : "-" %></td>
                  <td><%= row[:input_demo_inm].present? ? quantity.call(row[:input_demo_inm]) : "-" %></td>
                  <td><%= row[:input_demo_pm].present? ? quantity.call(row[:input_demo_pm]) : "-" %></td>
                  <td><%= row[:ffs].present? ? quantity.call(row[:ffs]) : "-" %></td>
                  <td><%= quantity.call(row[:completed]) %></td>
                  <td><%= quantity.call(row[:pending]) %></td>
                  <td><span class="grid-status <%= row[:pending].to_f.zero? ? "approved" : "pending" %>"><%= row[:progress] %></span></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="20">No target has been assigned to this Jeevika Jankar yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination" data-pagination-for="vrp_target_progress_table"></div>
    </section>

    <% selected_target_week = params[:target_week].presence || "all" %>
    <% target_week_options = [["All Weeks", "all"], ["Week 1", "week_1"], ["Week 2", "week_2"], ["Week 3", "week_3"], ["Week 4", "week_4"]] %>
    <section class="module-card" id="vrp_weekly_target_plan">
      <div class="module-card-header weekly-plan-header">
        <div>
          <h2>Weekly Target Plan</h2>
          <p>Review the work planned for each week and compare it with overall progress.</p>
        </div>
        <div class="dashboard-actions">
          <%= form_with url: dashboard_path, method: :get, local: true, class: "weekly-plan-filter" do |form| %>
            <%= form.label :target_week, "Week" %>
            <%= form.select :target_week, options_for_select(target_week_options, selected_target_week), {}, onchange: "this.form.submit()" %>
          <% end %>
          <button type="button" class="list-btn export" data-export-table="vrp_weekly_target_table">Export</button>
        </div>
      </div>

      <div class="table-shell">
        <table class="module-table compact-table" id="vrp_weekly_target_table" data-paginated-table data-page-size="15">
          <thead>
            <tr>
              <th>Month</th>
              <th>Village</th>
              <th>Main Activity</th>
              <th>Sub Activity</th>
              <th>Total Target</th>
              <% if selected_target_week == "all" %>
                <th>Week 1 Plan</th><th>Week 2 Plan</th><th>Week 3 Plan</th><th>Week 4 Plan</th>
              <% else %>
                <th><%= target_week_options.to_h.key(selected_target_week) %> Plan</th>
              <% end %>
              <th>Overall Completed</th>
              <th>Overall Pending</th>
              <th>Completion Date</th>
            </tr>
          </thead>
          <tbody>
            <% if @vrp_target_rows.any? %>
              <% @vrp_target_rows.each do |row| %>
                <tr>
                  <td><%= row[:month] %></td>
                  <td><%= row[:village] %></td>
                  <td><%= row[:main_activity] %></td>
                  <td><%= row[:activity] %></td>
                  <td><%= quantity.call(row[:target]) %></td>
                  <% if selected_target_week == "all" %>
                    <td><%= quantity.call(row[:week_1]) %></td><td><%= quantity.call(row[:week_2]) %></td><td><%= quantity.call(row[:week_3]) %></td><td><%= quantity.call(row[:week_4]) %></td>
                  <% else %>
                    <td><%= quantity.call(row[selected_target_week.to_sym]) %></td>
                  <% end %>
                  <td><%= quantity.call(row[:completed]) %></td>
                  <td><%= quantity.call(row[:pending]) %></td>
                  <td><%= row[:completion_date] %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="<%= selected_target_week == 'all' ? 12 : 9 %>">No weekly target plan has been assigned yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination" data-pagination-for="vrp_weekly_target_table"></div>
    </section>
  </section>
<% else %>
<%# =====================================================================
    ADMIN / STAFF DASHBOARD
    ===================================================================== %>
<section class="dashboard-page">

  <%# ── TOP BAR ─────────────────────────────────────────────────────── %>
  <div class="dashboard-topbar">
    <div>
      <p class="vrp-eyebrow">Dashboard Module</p>
      <h1><%= @dashboard_title.presence || "Dashboard" %></h1>
      <p><%= @dashboard_caption.presence || "Live system summary." %></p>
    </div>

    <div class="dashboard-actions">
      <div class="dashboard-header-clock" aria-label="Live Clock">
        <span>Live</span>
        <strong data-dashboard-clock-time><%= @dashboard_generated_at.strftime("%I:%M:%S %p") %></strong>
        <small data-dashboard-clock-date><%= @dashboard_generated_at.strftime("%d %b %Y") %></small>
      </div>
      <div class="list-search">
        <span>⌕</span>
        <input type="search" placeholder="Search dashboard" data-dashboard-search>
      </div>
      <%= link_to "Export Excel",
            dashboard_path(request.query_parameters.merge(format: :xlsx)),
            class: "list-btn export",
            title: "Current filters ke hisaab se dashboard data export" %>
    </div>
  </div>

  <%# ── FILTER BAR ───────────────────────────────────────────────────── %>
  <%= form_with url: dashboard_path, method: :get, local: true,
        id: "dashboard-filter-form", class: "dashboard-filter-bar" do |f| %>
    <% if params[:training_month].present? %>
      <%= hidden_field_tag :training_month, params[:training_month] %>
    <% end %>
    <% if params[:training_sub_activity].present? %>
      <%= hidden_field_tag :training_sub_activity, params[:training_sub_activity] %>
    <% end %>
    <div class="dashboard-filter-grid">


      <%# Activity %>
      <div class="dashboard-filter-field dashboard-filter-field--activity">
        <label for="dash_activity">Activity</label>
        <details class="dashboard-activity-picker" data-dashboard-activity-picker>
          <summary class="dashboard-activity-picker-summary">
            <span data-activity-label><%= params[:activity].presence || "All Activities" %></span>
          </summary>
          <div class="dashboard-activity-picker-menu" role="listbox">
            <button type="button"
                    class="dashboard-activity-option <%= "is-selected" if params[:activity].blank? %>"
                    data-activity-value=""
                    role="option">All Activities</button>
            <% (@filter_activity_options || []).each do |activity_name| %>
              <button type="button"
                      class="dashboard-activity-option <%= "is-selected" if params[:activity].to_s == activity_name.to_s %>"
                      data-activity-value="<%= activity_name %>"
                      title="<%= activity_name %>"
                      role="option"><%= activity_name %></button>
            <% end %>
          </div>
        </details>
        <input type="hidden" name="activity" id="dash_activity" value="<%= params[:activity] %>" data-activity-input>
      </div>

      <%# FCO %>
      <div class="dashboard-filter-field">
        <label for="dash_fcoc">FCO</label>
        <%= f.select :fcoc,
              options_for_select(
                [["All FCO", ""]] + (@filter_fcoc_options || []).map { |v| [v, v] },
                params[:fcoc]
              ),
              {},
              id: "dash_fcoc", class: "form-select dashboard-filter-select",
              data: { dashboard_filter_select: true } %>
      </div>

      <%# Cluster Incharge %>
      <div class="dashboard-filter-field">
        <label for="dash_ci">Cluster Incharge</label>
        <%= f.select :cluster_incharge,
              options_for_select(
                [["All Incharge", ""]] + (@filter_cluster_incharge_options || []).map { |v| [v, v] },
                params[:cluster_incharge]
              ),
              {},
              id: "dash_ci", class: "form-select dashboard-filter-select",
              data: { dashboard_filter_select: true } %>
      </div>

      <%# Month %>
      <div class="dashboard-filter-field">
        <label for="dash_month">Month</label>
        <%= f.select :month,
              options_for_select(
                [["All Months", ""]] + (@filter_month_options || []).map { |v| [v, v] },
                params[:month]
              ),
              {},
              id: "dash_month", class: "form-select dashboard-filter-select",
              data: { dashboard_filter_select: true } %>
      </div>

      <%# Post-wise Name (Role) %>
      <div class="dashboard-filter-field">
        <label for="dash_post">Post-wise Name</label>
        <%= f.select :post,
              options_for_select(
                [["All Posts", ""]] + (@filter_post_options || []).map { |v| [v, v] },
                params[:post]
              ),
              {},
              id: "dash_post", class: "form-select dashboard-filter-select",
              data: { dashboard_filter_select: true } %>
      </div>

      <%# VRP Name %>
      <div class="dashboard-filter-field">
        <label for="dash_vrp">VRP Name</label>
        <%= f.select :vrp_id,
              options_for_select(
                [["All VRPs", ""]] + (@filter_vrp_options || []),
                params[:vrp_id]
              ),
              {},
              id: "dash_vrp", class: "form-select dashboard-filter-select",
              data: { dashboard_filter_select: true } %>
      </div>

      <div class="dashboard-filter-actions">
        <%= f.submit "Apply Filters", class: "list-btn active", id: "dash_apply_filters" %>
        <%= link_to "Clear", dashboard_path, class: "table-action", id: "dash_clear_filters" %>
      </div>
    </div>
  <% end %>

  <%# Active filter chips (visible when any filter is set) %>
  <% active_filters = [
    params[:search].present?           ? "Search: #{params[:search]}"                 : nil,
    params[:activity].present?         ? "Activity: #{params[:activity]}"             : nil,
    params[:fcoc].present?             ? "FCO: #{params[:fcoc]}"                      : nil,
    params[:cluster_incharge].present? ? "Cluster: #{params[:cluster_incharge]}"      : nil,
    params[:month].present?            ? "Month: #{params[:month]}"                   : nil,
    params[:post].present?             ? "Post: #{params[:post]}"                     : nil,
    params[:vrp_id].present?           ? "VRP ##{params[:vrp_id]}"                   : nil
  ].compact %>
  <% if active_filters.any? %>
    <div class="dashboard-filter-chips">
      <span class="filter-chips-label">Active Filters:</span>
      <% active_filters.each do |chip| %>
        <span class="filter-chip"><%= chip %></span>
      <% end %>
      <%= link_to "✕ Clear All", dashboard_path, class: "filter-chip-clear" %>
    </div>
  <% end %>

  <%# ── METRIC CARDS ─────────────────────────────────────────────────── %>
  <div class="dashboard-grid premium">
    <% @dashboard_cards.each_with_index do |card, index| %>
      <% next if card.blank? %>
      <% if card.is_a?(Hash) && card[:items].present? %>
        <article class="metric-card metric-card-group metric-card-group-<%= card[:style] %>">
          <span class="metric-card-group-title"><%= card[:title] %></span>
          <div class="metric-card-group-items">
            <% card[:items].each do |item| %>
              <%= link_to item[:path], class: "metric-card-group-item metric-card-group-item-#{item[:title].to_s.parameterize}", data: { dashboard_card: true } do %>
                <span><%= item[:title] %></span>
                <strong><%= item[:value] %></strong>
              <% end %>
            <% end %>
          </div>
        </article>
        <% next %>
      <% end %>
      <% title   = card.is_a?(Hash) ? card[:title]   : card[0] %>
      <% value   = card.is_a?(Hash) ? card[:value]   : card[1] %>
      <% caption = card.is_a?(Hash) ? card[:caption] : card[2] %>
      <% path    = card.is_a?(Hash) && card[:path].present? ? card[:path] : dashboard_path %>
      <%= link_to path, class: "metric-card-link", data: { dashboard_card: true } do %>
        <article class="metric-card <%= "featured" if index.zero? %>">
          <div>
            <span><%= title %></span>
            <strong><%= value %></strong>
            <small><%= caption %></small>
          </div>
          <b>↗</b>
        </article>
      <% end %>
    <% end %>
  </div>


  <%# ── TRAINING DASHBOARD ───────────────────────────────────────────── %>
  <% participation = @training_participation || { totals: { green: 0, yellow: 0, red: 0, total: 0 }, ics_rows: [], village_rows: [] } %>
  <% training_rows = @farmer_training_dashboard_rows || [] %>
  <%= render "farmer_training_dashboard", training_rows: training_rows, participation: participation %>

  <%# ── WEEKLY TARGET STATUS BOXES ONLY (full data on report page) ── %>
  <% weekly_cards = @dashboard_weekly_target_cards || [] %>
  <% weekly_selected_month = @weekly_dashboard_selected_month.to_s %>
  <% weekly_month_filter_value = @weekly_target_month_filter_value.to_s %>
  <% weekly_fcoc_filter_value = @weekly_target_fcoc_filter_value.to_s %>
  <section class="module-card training-participation-status-card dashboard-status-panel weekly-status-panel" id="dashboard_weekly_target_boxes">
    <div class="module-card-header training-participation-status-header">
      <div>
        <h2>Weekly Activity Target Status</h2>
        <p>Dashboard pe sirf colour boxes. Full Activity / Sub Activity weekly report alag page pe dekho aur export karo.</p>
      </div>
      <div class="dashboard-actions">
        <%= form_with url: dashboard_path, method: :get, local: true, html: { class: "dashboard-month-filter" } do %>
          <%= hidden_field_tag :participation_month, @participation_month_filter_value if @participation_month_filter_value.present? %>
          <%= hidden_field_tag :participation_fcoc, @participation_fcoc_filter_value if @participation_fcoc_filter_value.present? %>
          <label class="dashboard-month-select">
            <span>Month</span>
            <select name="weekly_target_month" onchange="this.form.submit()">
              <option value="all" <%= "selected" if weekly_month_filter_value == "all" %>>All</option>
              <% Array(@training_month_options).each do |option| %>
                <option value="<%= option %>" <%= "selected" if weekly_selected_month == option.to_s %>><%= option %></option>
              <% end %>
            </select>
          </label>
          <label class="dashboard-month-select">
            <span>FCOC</span>
            <select name="weekly_target_fcoc" onchange="this.form.submit()">
              <option value="">All FCOC</option>
              <% Array(@filter_fcoc_options).each do |option| %>
                <option value="<%= option %>" <%= "selected" if weekly_fcoc_filter_value == option.to_s %>><%= option %></option>
              <% end %>
            </select>
          </label>
        <% end %>
        <% weekly_report_params = dashboard_weekly_report_filter_params %>
        <% weekly_report_params.delete(:training_month) %>
        <% weekly_report_params[:training_month] = weekly_selected_month if weekly_selected_month.present? %>
        <% weekly_report_params[:training_fcoc] = weekly_fcoc_filter_value if weekly_fcoc_filter_value.present? %>
        <%= link_to "Open Weekly Report", weekly_activity_target_report_path(weekly_report_params), class: "list-btn active" %>
        <%= link_to "Export Excel", weekly_activity_target_report_path(weekly_report_params.merge(format: :xlsx)), class: "list-btn export" %>
      </div>
    </div>

    <div class="training-participation-boxes">
      <% if weekly_cards.any? %>
        <% weekly_cards.each do |card| %>
          <%= link_to card[:path], class: "training-participation-box #{card[:status]}", data: { dashboard_card: true } do %>
            <span><%= card[:title] %></span>
            <strong><%= card[:value].to_i %></strong>
            <small><%= card[:caption] %></small>
            <b>View Report</b>
          <% end %>
        <% end %>
      <% else %>
        <div class="training-empty-state">No target data found for selected filters.</div>
      <% end %>
    </div>
  </section>

</section>
<% end %>
