<% content_for :title, "Dashboard" %>

<% if @vrp_dashboard %>
  <% quantity = ->(value) { value.to_f == value.to_i ? value.to_i : format("%.2f", value.to_f) } %>
  <section class="dashboard-page">
    <div class="dashboard-topbar">
      <div>
        <p class="vrp-eyebrow">VRP Dashboard</p>
        <h1><%= @vrp&.name.presence || current_app_user["name"].presence || "Dashboard" %></h1>
        <p>Your mapped farmers, villages, assigned targets, and completed work summary.</p>
      </div>

      <div class="dashboard-actions">
        <div class="dashboard-header-clock" aria-label="Live Clock">
          <span>Live</span>
          <strong data-dashboard-clock-time><%= @dashboard_generated_at.strftime("%I:%M:%S %p") %></strong>
          <small data-dashboard-clock-date><%= @dashboard_generated_at.strftime("%d %b %Y") %></small>
        </div>
        <%= link_to "Participation Report", farmer_participation_report_path, class: "list-btn" %>
        <%= link_to "View Targets", target_mappings_path, class: "list-btn active" %>
      </div>
    </div>

    <% dashboard_cards_by_title = @dashboard_cards.index_by { |card| card[:title] } %>
    <% if @dashboard_farmer_activity_mode %>
      <div class="dashboard-grid premium">
        <% @dashboard_cards.each_with_index do |card, index| %>
          <% next if card.blank? %>
          <% if card.is_a?(Hash) && card[:items].present? %>
            <article class="metric-card metric-card-group metric-card-group-<%= card[:style] %>">
              <span class="metric-card-group-title"><%= card[:title] %></span>
              <div class="metric-card-group-items">
                <% card[:items].each do |item| %>
                  <%= link_to item[:path], class: "metric-card-group-item metric-card-group-item-#{item[:title].to_s.parameterize}", data: { dashboard_card: true } do %>
                    <span><%= item[:title] %></span>
                    <strong><%= item[:value] %></strong>
                  <% end %>
                <% end %>
              </div>
            </article>
            <% next %>
          <% end %>
          <% title   = card.is_a?(Hash) ? card[:title]   : card[0] %>
          <% value   = card.is_a?(Hash) ? card[:value]   : card[1] %>
          <% caption = card.is_a?(Hash) ? card[:caption] : card[2] %>
          <% path    = card.is_a?(Hash) && card[:path].present? ? card[:path] : dashboard_path %>
          <%= link_to path, class: "metric-card-link", data: { dashboard_card: true } do %>
            <article class="metric-card <%= "featured" if index.zero? %>">
              <div>
                <span><%= title %></span>
                <strong><%= value %></strong>
              </div>
              <b>↗</b>
            </article>
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% demonstration_method_titles = ["OPG Target", "OPG Achievement", "General Training/Meeting", "Input Demo INM", "FFS", "Input Demo PM"] %>
    <% all_dashboard_summary_cards = Array(@dashboard_summary_cards) %>
    <% demonstration_method_cards = Array(@demonstration_method_cards).presence || all_dashboard_summary_cards.select { |card| demonstration_method_titles.include?(card[:title].to_s) } %>
    <% dashboard_summary_cards = all_dashboard_summary_cards.reject { |card| demonstration_method_titles.include?(card[:title].to_s) } %>
    <% if dashboard_summary_cards.any? %>
      <section class="module-card training-participation-status-card dashboard-status-panel dashboard-summary-panel" id="dashboard_summary_boxes">
        <div class="module-card-header training-participation-status-header">
          <div>
            <h2>Dashboard Summary</h2>
          </div>
        </div>

        <div class="training-participation-boxes dashboard-summary-boxes">
          <% dashboard_summary_cards.each do |card| %>
            <div class="training-participation-box total dashboard-summary-box">
              <span><%= card[:title] %></span>
              <strong><%= card[:value] %></strong>
              <div class="dashboard-summary-actions">
                <span class="dashboard-summary-action-popover">
                  <%= link_to "View List", card[:path], class: "table-action", data: { dashboard_card: true } %>
                  <% if Array(card[:popup_items]).any? %>
                    <span class="dashboard-card-hover-popup" role="tooltip">
                      <% Array(card[:popup_items]).each do |item| %>
                        <span><%= item %></span>
                      <% end %>
                    </span>
                  <% end %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @dashboard_farmer_activity_mode %>
      <%= render "farmer_training_dashboard" %>
    <% end %>

    <% if demonstration_method_cards.any? %>
      <section class="module-card training-participation-status-card dashboard-status-panel dashboard-summary-panel demonstration-method-panel" id="demonstration_method_boxes">
        <div class="module-card-header training-participation-status-header">
          <div>
            <h2>Demonstration Method</h2>
          </div>
        </div>

        <div class="training-participation-boxes dashboard-summary-boxes demonstration-method-boxes">
          <% demonstration_method_cards.each do |card| %>
            <div class="training-participation-box total dashboard-summary-box">
              <span><%= card[:title] %></span>
              <strong><%= card[:value] %></strong>
              <div class="dashboard-summary-actions">
                <%= link_to "View List", card[:path], class: "table-action", data: { dashboard_card: true } %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="module-card vrp-work-overview">
      <div class="vrp-work-overview-header">
        <div>
          <h2>Work Overview</h2>
          <p><%= @training_selected_month %> assigned work area and target progress.</p>
        </div>
        <div class="dashboard-actions">
          <%= form_with url: dashboard_path, method: :get, local: true do |form| %>
            <%= form.label :training_month, "Month" %>
            <%= form.select :training_month,
                  options_for_select(@training_month_options.map { |month| [month, month] }, @training_selected_month),
                  {},
                  onchange: "this.form.submit()" %>
          <% end %>
          <span>Click any number to open its monthly detailed list</span>
        </div>
      </div>
      <div class="vrp-work-overview-metrics">
        <% ["Mapped Villages", "Main Activities", "Sub Activities", "Assigned Target", "Achieved Target", "Pending Target"].each do |title| %>
          <% card = dashboard_cards_by_title[title] %>
          <%= link_to card[:path], class: "#{title.parameterize}", title: card[:caption], data: { dashboard_card: true } do %>
            <span><%= title %></span>
            <strong><%= card[:value] %></strong>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="module-card" id="vrp_target_progress">
      <div class="module-card-header">
        <h2>Assigned Target Progress</h2>
      </div>

      <div class="table-shell">
        <table class="module-table compact-table" id="vrp_target_progress_table" data-paginated-table data-page-size="15">
          <thead>
            <tr>
              <th>Month</th>
              <th>Completion Date</th>
              <th>FCO</th>
              <th>Village</th>
              <th>Farmers</th>
              <th>Main Activity</th>
              <th>Sub Activity</th>
              <th>Targeted Farmer</th>
              <th>Week 1</th>
              <th>Week 2</th>
              <th>Week 3</th>
              <th>Week 4</th>
              <th>OPG Training</th>
              <th>General Training/Meeting</th>
              <th>Input Demo INM</th>
              <th>Input Demo PM</th>
              <th>FFS</th>
              <th>Completed</th>
              <th>Pending</th>
              <th>Progress</th>
            </tr>
          </thead>
          <tbody>
            <% if @vrp_target_rows.any? %>
              <% @vrp_target_rows.each do |row| %>
                <tr>
                  <td><%= row[:month] %></td>
                  <td><%= row[:completion_date].presence || "-" %></td>
                  <td><%= row[:fco] %></td>
                  <td><%= row[:village] %></td>
                  <td><%= row[:farmers] %></td>
                  <% main_activity_list = Array(row[:main_activities]).presence || row[:main_activity].to_s.split("\n").map(&:strip).reject(&:blank?) %>
                  <% sub_activity_list = Array(row[:sub_activities]).presence || row[:activity].to_s.split("\n").map(&:strip).reject(&:blank?) %>
                  <td class="target-activity-text">
                    <div class="target-activity-grouped-list">
                      <% main_activity_list.each do |main_activity| %>
                        <span><%= main_activity %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="target-activity-text">
                    <div class="target-activity-grouped-list">
                      <% sub_activity_list.each do |sub_activity| %>
                        <span><%= sub_activity %></span>
                      <% end %>
                    </div>
                  </td>
                  <td><%= quantity.call(row[:target]) %></td>
                  <td><%= quantity.call(row[:week_1]) %></td>
                  <td><%= quantity.call(row[:week_2]) %></td>
                  <td><%= quantity.call(row[:week_3]) %></td>
                  <td><%= quantity.call(row[:week_4]) %></td>
                  <td><%= row[:opg_training].present? ? quantity.call(row[:opg_training]) : "-" %></td>
                  <td><%= row[:general_training].present? ? quantity.call(row[:general_training]) : "-" %></td>
                  <td><%= row[:input_demo_inm].present? ? quantity.call(row[:input_demo_inm]) : "-" %></td>
                  <td><%= row[:input_demo_pm].present? ? quantity.call(row[:input_demo_pm]) : "-" %></td>
                  <td><%= row[:ffs].present? ? quantity.call(row[:ffs]) : "-" %></td>
                  <td><%= quantity.call(row[:completed]) %></td>
                  <td><%= quantity.call(row[:pending]) %></td>
                  <td><span class="grid-status <%= row[:pending].to_f.zero? ? "approved" : "pending" %>"><%= row[:progress] %></span></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="20">No target has been assigned to this Jeevika Jankar yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination" data-pagination-for="vrp_target_progress_table"></div>
    </section>

    <% selected_target_week = params[:target_week].presence || "all" %>
    <% target_week_options = [["All Weeks", "all"], ["Week 1", "week_1"], ["Week 2", "week_2"], ["Week 3", "week_3"], ["Week 4", "week_4"]] %>
    <section class="module-card" id="vrp_weekly_target_plan">
      <div class="module-card-header weekly-plan-header">
        <div>
          <h2>Weekly Target Plan</h2>
          <p>Review the work planned for each week and compare it with overall progress.</p>
        </div>
        <div class="dashboard-actions">
          <%= form_with url: dashboard_path, method: :get, local: true, class: "weekly-plan-filter" do |form| %>
            <%= form.label :target_week, "Week" %>
            <%= form.select :target_week, options_for_select(target_week_options, selected_target_week), {}, onchange: "this.form.submit()" %>
          <% end %>
        </div>
      </div>

      <div class="table-shell">
        <table class="module-table compact-table" id="vrp_weekly_target_table" data-paginated-table data-page-size="15">
          <thead>
            <tr>
              <th>Month</th>
              <th>Village</th>
              <th>Main Activity</th>
              <th>Sub Activity</th>
              <th>Targeted Farmer</th>
              <% if selected_target_week == "all" %>
                <th>Week 1 Plan</th><th>Week 2 Plan</th><th>Week 3 Plan</th><th>Week 4 Plan</th>
              <% else %>
                <th><%= target_week_options.to_h.key(selected_target_week) %> Plan</th>
                <th><%= target_week_options.to_h.key(selected_target_week) %> Achieved</th>
              <% end %>
              <th>Overall Completed</th>
              <th>Overall Pending</th>
              <th>Completion Date</th>
            </tr>
          </thead>
          <tbody>
            <% if @vrp_target_rows.any? %>
              <% @vrp_target_rows.each do |row| %>
                <tr>
                  <td><%= row[:month] %></td>
                  <td><%= row[:village] %></td>
                  <% main_activity_list = Array(row[:main_activities]).presence || row[:main_activity].to_s.split("\n").map(&:strip).reject(&:blank?) %>
                  <% sub_activity_list = Array(row[:sub_activities]).presence || row[:activity].to_s.split("\n").map(&:strip).reject(&:blank?) %>
                  <td class="target-activity-text">
                    <div class="target-activity-grouped-list">
                      <% main_activity_list.each do |main_activity| %>
                        <span><%= main_activity %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="target-activity-text">
                    <div class="target-activity-grouped-list">
                      <% sub_activity_list.each do |sub_activity| %>
                        <span><%= sub_activity %></span>
                      <% end %>
                    </div>
                  </td>
                  <td><%= quantity.call(row[:target]) %></td>
                  <% if selected_target_week == "all" %>
                    <td><%= quantity.call(row[:week_1]) %></td><td><%= quantity.call(row[:week_2]) %></td><td><%= quantity.call(row[:week_3]) %></td><td><%= quantity.call(row[:week_4]) %></td>
                  <% else %>
                    <td><%= quantity.call(row[selected_target_week.to_sym]) %></td>
                    <td><%= quantity.call(row["#{selected_target_week}_achieved".to_sym]) %></td>
                  <% end %>
                  <td><%= quantity.call(row[:completed]) %></td>
                  <td><%= quantity.call(row[:pending]) %></td>
                  <td><%= row[:completion_date] %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="<%= selected_target_week == 'all' ? 12 : 10 %>">No weekly target plan has been assigned yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="table-pagination" data-pagination-for="vrp_weekly_target_table"></div>
    </section>
  </section>
<% else %>
<%# =====================================================================
    ADMIN / STAFF DASHBOARD
    ===================================================================== %>
<section class="dashboard-page">

  <%# ── TOP BAR ─────────────────────────────────────────────────────── %>
  <div class="dashboard-topbar">
    <div>
      <p class="vrp-eyebrow">Dashboard Module</p>
      <h1><%= @dashboard_title.presence || "Dashboard" %></h1>
      <p><%= @dashboard_caption.presence || "Live system summary." %></p>
    </div>

    <div class="dashboard-actions">
      <div class="dashboard-header-clock" aria-label="Live Clock">
        <span>Live</span>
        <strong data-dashboard-clock-time><%= @dashboard_generated_at.strftime("%I:%M:%S %p") %></strong>
        <small data-dashboard-clock-date><%= @dashboard_generated_at.strftime("%d %b %Y") %></small>
      </div>
      <div class="list-search">
        <span>⌕</span>
        <input type="search" placeholder="Search dashboard" data-dashboard-search>
      </div>
    </div>
  </div>

  <%# ── FILTER BAR ───────────────────────────────────────────────────── %>
  <%= form_with url: dashboard_path, method: :get, local: true,
        id: "dashboard-filter-form", class: "dashboard-filter-bar" do |f| %>
    <% if params[:training_month].present? %>
      <%= hidden_field_tag :training_month, params[:training_month] %>
    <% end %>
    <% if params[:training_sub_activity].present? %>
      <%= hidden_field_tag :training_sub_activity, params[:training_sub_activity] %>
    <% end %>
    <% if params[:weekly_target_week].present? %>
      <%= hidden_field_tag :weekly_target_week, params[:weekly_target_week] %>
    <% end %>
    <% if params[:ics_report_ics].present? %>
      <%= hidden_field_tag :ics_report_ics, params[:ics_report_ics] %>
    <% end %>
    <% if params[:activity_overview_month].present? %>
      <%= hidden_field_tag :activity_overview_month, params[:activity_overview_month] %>
    <% end %>
    <% if params[:activity_overview_fcoc].present? %>
      <%= hidden_field_tag :activity_overview_fcoc, params[:activity_overview_fcoc] %>
    <% end %>
    <div class="dashboard-filter-grid">


      <div class="dashboard-filter-field">
        <label for="dash_main_activity">Main Activity</label>
        <%= f.select :main_activity, options_for_select([["All Main Activities", ""]] + Array(@filter_main_activity_options).map { |v| [v, v] }, @dashboard_main_activity_filter_value), {}, id: "dash_main_activity", class: "form-select dashboard-filter-select", data: { dashboard_filter_select: true } %>
      </div>

      <div class="dashboard-filter-field">
        <label for="dash_sub_activity">Sub Activity</label>
        <%= f.select :sub_activity, options_for_select([["All Sub Activities", ""]] + Array(@filter_sub_activity_options).map { |v| [v, v] }, params[:sub_activity]), {}, id: "dash_sub_activity", class: "form-select dashboard-filter-select", data: { dashboard_filter_select: true } %>
      </div>

      <%# FCO %>
      <div class="dashboard-filter-field">
        <label for="dash_fcoc">FCO</label>
        <%= f.select :fcoc,
              options_for_select(
                [["All FCO", ""]] + (@filter_fcoc_options || []).map { |v| [v, v] },
                @dashboard_fcoc_filter_value
              ),
              {},
              id: "dash_fcoc", class: "form-select dashboard-filter-select", data: { dashboard_filter_select: true } %>
      </div>

      <%# ICS Name (cascades from the selected activity, FCO and Cluster Incharge) %>
      <div class="dashboard-filter-field">
        <label for="dash_ics">ICS Name</label>
        <%= f.select :ics,
              options_for_select(
                [["All ICS", ""]] + (@filter_ics_options || []).map { |v| [v, v] },
                params[:ics]
              ),
              {},
              id: "dash_ics", class: "form-select dashboard-filter-select", data: { dashboard_filter_select: true } %>
      </div>

      <%# Month %>
      <div class="dashboard-filter-field">
        <label for="dash_month">Month</label>
        <%= f.select :month,
              options_for_select(
                [["All Months", ""]] + (@filter_month_options || []).map { |v| [v, v] },
                @dashboard_month_filter_value
              ),
              {},
              id: "dash_month", class: "form-select dashboard-filter-select", data: { dashboard_filter_select: true } %>
      </div>

      <div class="dashboard-filter-actions">
        <%= f.submit "Apply Filters", class: "list-btn active", id: "dash_apply_filters" %>
        <%= link_to "Clear", dashboard_path, class: "table-action", id: "dash_clear_filters", data: { turbo: false, turbo_prefetch: false } %>
      </div>
    </div>
  <% end %>

  <%# Active filter chips (visible when any filter is set) %>
  <% active_filters = [
    params[:search].present?           ? "Search: #{params[:search]}"                 : nil,
    params[:activity].present?         ? "Activity: #{params[:activity]}"             : nil,
    params[:fcoc].present?             ? "FCO: #{params[:fcoc]}"                      : nil,
    params[:month].present?            ? "Month: #{params[:month]}"                   : nil,
    params[:vrp_id].present?           ? "VRP ##{params[:vrp_id]}"                   : nil
  ].compact %>
  <% if active_filters.any? %>
    <div class="dashboard-filter-chips">
      <span class="filter-chips-label">Active Filters:</span>
      <% active_filters.each do |chip| %>
        <span class="filter-chip"><%= chip %></span>
      <% end %>
      <%= link_to "✕ Clear All", dashboard_path, class: "filter-chip-clear", data: { turbo: false, turbo_prefetch: false } %>
    </div>
  <% end %>

  <% demonstration_method_titles = ["OPG Target", "OPG Achievement", "General Training/Meeting", "Input Demo INM", "FFS", "Input Demo PM"] %>
  <% all_dashboard_summary_cards = Array(@dashboard_summary_cards) %>
  <% demonstration_method_cards = Array(@demonstration_method_cards).presence || all_dashboard_summary_cards.select { |card| demonstration_method_titles.include?(card[:title].to_s) } %>
  <% dashboard_summary_cards = all_dashboard_summary_cards.reject { |card| demonstration_method_titles.include?(card[:title].to_s) } %>
  <% if dashboard_summary_cards.any? %>
    <section class="module-card training-participation-status-card dashboard-status-panel dashboard-summary-panel" id="dashboard_summary_boxes">
      <div class="module-card-header training-participation-status-header">
        <div>
          <h2>Dashboard Summary</h2>
        </div>
      </div>

      <div class="training-participation-boxes dashboard-summary-boxes">
        <% dashboard_summary_cards.each do |card| %>
          <div class="training-participation-box total dashboard-summary-box">
            <span><%= card[:title] %></span>
            <strong><%= card[:value] %></strong>
            <div class="dashboard-summary-actions">
              <span class="dashboard-summary-action-popover">
                <%= link_to "View List", card[:path], class: "table-action", data: { dashboard_card: true } %>
                <% if Array(card[:popup_items]).any? %>
                  <span class="dashboard-card-hover-popup" role="tooltip">
                    <% Array(card[:popup_items]).each do |item| %>
                      <span><%= item %></span>
                    <% end %>
                  </span>
                <% end %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% main_activity_filter_value = params[:main_activity].presence || @dashboard_main_activity_filter_value.presence %>
  <% normalized_main_activity_filter = main_activity_filter_value.to_s.downcase.strip %>
  <% farmer_activity_mode = @dashboard_farmer_activity_mode ||
       normalized_main_activity_filter.include?("training") ||
       normalized_main_activity_filter.include?("farmer activity") %>

  <% if farmer_activity_mode %>
    <%# ── TRAINING DASHBOARD ───────────────────────────────────────────── %>
    <%= render "farmer_training_dashboard" %>
  <% end %>

  <% if demonstration_method_cards.any? %>
    <section class="module-card training-participation-status-card dashboard-status-panel dashboard-summary-panel demonstration-method-panel" id="demonstration_method_boxes">
      <div class="module-card-header training-participation-status-header">
        <div>
          <h2>Demonstration Method</h2>
        </div>
      </div>

      <div class="training-participation-boxes dashboard-summary-boxes demonstration-method-boxes">
        <% demonstration_method_cards.each do |card| %>
          <div class="training-participation-box total dashboard-summary-box">
            <span><%= card[:title] %></span>
            <strong><%= card[:value] %></strong>
            <div class="dashboard-summary-actions">
              <%= link_to "View List", card[:path], class: "table-action", data: { dashboard_card: true } %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if farmer_activity_mode %>
    <div class="dashboard-grid premium dashboard-training-secondary-summaries">
      <% Array(@dashboard_cards).sort_by { |card| ["Jeevika Jankar Registration", "Jeevika Jankar Billing", "Gender Count", "FCO-wise JJ Requirement"].index(card[:title]) || 99 }.each do |card| %>
        <% next if card.blank? %>
        <% next unless ["Jeevika Jankar Registration", "Jeevika Jankar Billing", "Gender Count", "FCO-wise JJ Requirement"].include?(card[:title]) %>
        <% next unless card.is_a?(Hash) && card[:items].present? %>
        <article class="metric-card metric-card-group metric-card-group-<%= card[:style] %>">
          <span class="metric-card-group-title"><%= card[:title] %></span>
          <div class="metric-card-group-items">
            <% card[:items].each do |item| %>
              <%= link_to item[:path], class: "metric-card-group-item metric-card-group-item-#{item[:title].to_s.parameterize}", data: { dashboard_card: true } do %>
                <span><%= item[:title] %></span>
                <strong><%= item[:value] %></strong>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

</section>
<% end %>
