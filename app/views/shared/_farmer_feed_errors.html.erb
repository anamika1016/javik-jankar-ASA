<% if record.errors.any? %>
  <div class="farmer-feed-errors farmer-feed-wide">
    <strong><%= pluralize(record.errors.count, "problem") %> stopped this from being published:</strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
