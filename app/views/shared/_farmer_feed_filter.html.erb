<%# State filter shared by the news and video screens. %>
<section class="module-card farmer-date-bar">
  <div class="farmer-date-form">
    <span class="farmer-feed-filter-label">Show</span>
    <div class="farmer-date-quick">
      <%= link_to "All Records", path, class: "list-btn #{'active' if state_filter.blank?}" %>
      <%= link_to "All States Only", path + "?state=all",
            class: "list-btn #{'active' if state_filter == 'all'}" %>
      <% broadcast_state_options.each do |name, id| %>
        <%= link_to name, path + "?state=#{id}", class: "list-btn #{'active' if state_filter == id}" %>
      <% end %>
    </div>
  </div>
</section>
