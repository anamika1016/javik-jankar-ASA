<%# Eight states as eight buttons was a wall of links. A select holds the
    long list; the two cases people actually click stay as buttons. %>
<section class="module-card farmer-filter-bar">
  <%= form_with url: path, method: :get, local: true, data: { turbo: false },
                html: { class: "farmer-filter-form" } do %>
    <div class="farmer-filter-chips">
      <%= link_to "All Records", path, class: "farmer-chip #{'is-on' if state_filter.blank?}" %>
      <%= link_to "All States Only", "#{path}?state=all",
            class: "farmer-chip #{'is-on' if state_filter == 'all'}" %>
    </div>
    <label class="farmer-field farmer-filter-select">
      <span>Filter by state</span>
      <select name="state" onchange="this.form.requestSubmit()">
        <option value="">Every record</option>
        <option value="all" <%= "selected" if state_filter == "all" %>>All States only</option>
        <% broadcast_state_options.each do |name, id| %>
          <option value="<%= id %>" <%= "selected" if state_filter == id %>><%= name %></option>
        <% end %>
      </select>
    </label>
  <% end %>
</section>
