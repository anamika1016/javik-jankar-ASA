<% content_for :title, "Accepted Agreement by Jeevika Jankar" %>

<section class="module-page agreement-archive-page">
  <div class="module-hero agreement-archive-toolbar">
    <div>
      <p class="vrp-eyebrow">Jeevika Jankar Registration</p>
      <h1>Accepted Agreement by Jeevika Jankar</h1>
      <p>All accepted declarations are listed here. Signature availability is shown separately.</p>
    </div>
    <div class="dashboard-actions">
      <%# The export follows the search, so what is downloaded matches what
          is on screen. %>
      <%= link_to "Export Excel", export_vrp_agreements_path(q: @search), class: "list-btn active" %>
      <%= link_to "Back to Dashboard", dashboard_path, class: "list-btn" %>
    </div>
  </div>

  <section class="module-card">
    <div class="module-card-header farmer-list-header">
      <h2>Accepted Agreements</h2>
      <div class="farmer-list-header-right">
        <span class="record-count"><%= @accepted_agreements.size %> records</span>
        <%= form_with url: vrp_agreements_path, method: :get, local: true, data: { turbo: false },
                      html: { class: "farmer-inline-search" } do %>
          <input type="search" name="q" value="<%= @search %>" aria-label="Search accepted agreements"
                 placeholder="Name, village, FCO, TO or mobile">
          <button type="submit" class="list-btn active">Search</button>
          <% if @search.present? %>
            <%= link_to "Clear", vrp_agreements_path, class: "list-btn" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="table-shell">
      <table class="module-table compact-table agreement-archive-table" data-page-size="<%= [@accepted_agreements.size, 1].max %>">
        <thead>
          <tr>
            <th>View</th>
            <th>Name</th>
            <th>FCO Name</th>
            <th>TO Name</th>
            <th>Village</th>
            <th>Mobile Number</th>
            <th>Signature</th>
            <% if agreement_admin_user? %>
              <th>Action</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% if @accepted_agreements.any? %>
            <% @accepted_agreements.each do |agreement| %>
              <tr>
                <td><%= link_to "Open", vrp_agreement_record_path(agreement[:id]), class: "table-action", target: "_blank", rel: "noopener" %></td>
                <td><%= agreement[:name] %></td>
                <td><%= agreement[:fcoc] %></td>
                <td><%= agreement[:to_name] %></td>
                <td><%= agreement[:village] %></td>
                <td><%= agreement[:mobile_no] %></td>
                <td><%= agreement[:signature_present] ? "Signed" : "Signature missing" %></td>
                <% if agreement_admin_user? %>
                  <td><%= button_to "Delete", reset_vrp_agreement_path(agreement[:id]), method: :delete, class: "table-action danger", form: { data: { turbo_confirm: "Delete this agreement and require signature again?" } } %></td>
                <% end %>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= agreement_admin_user? ? 8 : 7 %>">
                <%# A search finding nothing is a different thing from having
                    no agreements at all, and reads as a bug when worded the
                    same way. %>
                <% if @search.present? %>
                  No accepted agreement matches &ldquo;<%= @search %>&rdquo;.
                <% else %>
                  No accepted agreements found for your mapped Jeevika Jankars.
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</section>
