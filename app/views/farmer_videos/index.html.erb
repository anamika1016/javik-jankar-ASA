<% content_for :title, "Farmer Videos" %>

<section class="module-page farmer-login-page">
  <div class="module-hero">
    <div>
      <p class="vrp-eyebrow">Farmer 360</p>
      <h1>Farmer Videos</h1>
      <p>Videos published here appear in the Android app. Pick a state, or All States to reach everyone.</p>
    </div>
  </div>

  <%= render "shared/farmer_feed_filter", state_filter: @state_filter, path: farmer_videos_path %>

  <section class="module-card">
    <div class="module-card-header"><h2>Publish Video</h2></div>
    <%= form_with model: @record, url: farmer_videos_path, scope: :farmer_video,
                  method: :post, local: true, data: { turbo: false },
                  html: { class: "farmer-form", multipart: true } do |form| %>
      <%= render "shared/farmer_feed_errors", record: @record %>

      <div class="farmer-form-section">
        <p class="farmer-form-section-title">What the farmer sees</p>
        <div class="farmer-form-grid">
          <label class="farmer-field span-12">
            <span>Title *</span>
            <%= form.text_field :title, required: true, placeholder: "What the video is about" %>
          </label>
          <label class="farmer-field span-12">
            <span>Description</span>
            <%= form.text_area :description, rows: 3, placeholder: "Shown under the title in the app" %>
          </label>
        </div>
      </div>

      <div class="farmer-form-section">
        <p class="farmer-form-section-title">Who sees it, and when</p>
        <div class="farmer-form-grid">
          <%= render "shared/farmer_feed_common", form: form, state_options: broadcast_state_options,
                record: @record %>
          <label class="farmer-field span-4">
            <span>Duration</span>
            <%= form.text_field :duration_label, placeholder: "e.g. 4:30" %>
          </label>
        </div>
      </div>

      <div class="farmer-form-section">
        <p class="farmer-form-section-title">The video — link or file</p>
        <div class="farmer-form-grid">
          <label class="farmer-field span-6">
            <span>Video Link</span>
            <%= form.text_field :video_url, inputmode: "url", placeholder: "youtu.be/…" %>
            <small class="farmer-field-hint">https:// is added if you leave it out.</small>
          </label>
          <label class="farmer-field span-6">
            <span>Or Upload Video File</span>
            <%= form.file_field :video, accept: "video/*" %>
            <small class="farmer-field-hint">
              <%= FarmerBroadcastAdmin::VIDEO_EXTENSIONS.join(", ") %>
            </small>
          </label>
          <label class="farmer-field span-6">
            <span>Thumbnail Image</span>
            <%= form.file_field :thumbnail, accept: "image/*" %>
            <small class="farmer-field-hint">Shown as the tile before the video plays.</small>
          </label>
        </div>
      </div>

      <div class="farmer-form-actions">
        <button type="submit" class="list-btn active">Publish Video</button>
      </div>
    <% end %>
  </section>

  <section class="module-card">
    <div class="module-card-header">
      <h2>Published Videos</h2>
      <span class="record-count"><%= @total_count %> records</span>
    </div>

    <% if @records.blank? %>
      <p class="farmer-empty">No video published yet.</p>
    <% else %>
      <div class="table-shell">
        <table class="module-table compact-table">
          <thead>
            <tr>
              <th>#</th><th>Title</th><th>Description</th><th>State</th>
              <th>Source</th><th>Duration</th><th>Published</th><th>Status</th><th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @records.each_with_index do |video, index| %>
              <tr>
                <td><%= (@page - 1) * FarmerVideosController::PER_PAGE + index + 1 %></td>
                <td><strong><%= video.title %></strong>
                  <% if video.created_by.present? %>
                    <small class="farmer-sub">By <%= video.created_by %></small>
                  <% end %>
                </td>
                <td><%= truncate(video.description.to_s, length: 110) %></td>
                <td><%= render "shared/farmer_feed_state", item: video %></td>
                <td>
                  <%# Plays in a dialog on this page -- no new tab, and the
                      file is only fetched once Play is actually pressed. %>
                  <button type="button" class="farmer-video-play"
                          data-video-embed="<%= video.embed_url %>"
                          data-video-kind="<%= video.source_type %>"
                          data-video-title="<%= video.title %>">
                    <% if video.thumbnail_path.present? %>
                      <img src="<%= video.thumbnail_path %>" alt="" loading="lazy">
                    <% else %>
                      <span class="farmer-video-blank"></span>
                    <% end %>
                    <span class="farmer-video-icon" aria-hidden="true">▶</span>
                    <span class="visually-hidden">Play <%= video.title %></span>
                  </button>
                  <small class="farmer-sub">
                    <%= { "file" => "Uploaded file", "youtube" => "YouTube", "link" => "External link" }[video.source_type] %>
                  </small>
                </td>
                <td><%= video.duration_label.presence || "-" %></td>
                <td><%= farmer_login_time(video.published_at) %></td>
                <td><span class="status-pill <%= video.active? ? "active" : "inactive" %>"><%= video.status %></span></td>
                <td><%= render "shared/farmer_feed_actions", item: video,
                          toggle_path: toggle_status_farmer_video_path(video),
                          delete_path: farmer_video_path(video) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/farmer_feed_pager", page: @page, total_pages: @total_pages,
            path: farmer_videos_path, state_filter: @state_filter %>
    <% end %>
  </section>

  <dialog id="farmer-video-dialog" class="farmer-video-dialog">
    <div class="farmer-video-dialog-head">
      <strong id="farmer-video-dialog-title"></strong>
      <button type="button" class="list-btn" data-close-video>Close</button>
    </div>
    <div id="farmer-video-dialog-body" class="farmer-video-dialog-body"></div>
  </dialog>

  <script>
    (function () {
      var dialog = document.getElementById("farmer-video-dialog");
      if (!dialog) return;
      var body = document.getElementById("farmer-video-dialog-body");
      var heading = document.getElementById("farmer-video-dialog-title");

      function close() {
        // Emptying the body stops playback; leaving it would keep an
        // uploaded file streaming behind a closed dialog.
        body.innerHTML = "";
        if (dialog.open) dialog.close();
      }

      document.querySelectorAll(".farmer-video-play").forEach(function (button) {
        button.addEventListener("click", function () {
          var src = button.dataset.videoEmbed;
          if (!src) return;
          heading.textContent = button.dataset.videoTitle || "Video";

          if (button.dataset.videoKind === "file") {
            var video = document.createElement("video");
            video.src = src;
            video.controls = true;
            video.autoplay = true;
            video.playsInline = true;
            body.replaceChildren(video);
          } else {
            var frame = document.createElement("iframe");
            frame.src = src;
            frame.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
            frame.allowFullscreen = true;
            frame.referrerPolicy = "strict-origin-when-cross-origin";
            body.replaceChildren(frame);
          }
          dialog.showModal();
        });
      });

      dialog.addEventListener("close", close);
      dialog.addEventListener("click", function (event) {
        if (event.target === dialog || event.target.hasAttribute("data-close-video")) close();
      });
    })();
  </script>
</section>
