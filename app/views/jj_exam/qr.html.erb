<% content_for :title, "Scan Exam QR" %>

<main class="jj-exam-shell">
  <section class="jj-qr-panel">
    <div class="jj-qr-copy">
      <p class="vrp-eyebrow">QR Ready</p>
      <h1><%= @attempt.quiz.title %></h1>
      <p><strong><%= @attempt.vrp.user_name %></strong> - <%= @attempt.vrp.name %></p>
      <div class="jj-exam-steps compact">
        <span>Duration: <%= @attempt.quiz.duration_minutes %> min</span>
        <span>Questions: <%= @attempt.quiz.active_questions.count %></span>
        <span>Total Marks: <%= @attempt.quiz.total_marks.to_s("F") %></span>
      </div>
    </div>

    <div class="jj-qr-card">
      <% if @qr_svg.present? %>
        <%= raw @qr_svg %>
      <% else %>
        <div class="jj-qr-fallback">QR data is too long. Use the exam link below.</div>
      <% end %>
      <p>Scan this QR on a mobile device. Use the button below if you are taking the exam on this device.</p>
      <% if @qr_svg.present? %>
        <button type="button" class="jj-exam-primary secondary" data-copy-qr-image=".jj-qr-svg" data-copy-fallback-text="<%= @take_url %>" data-copy-success-label="QR Copied" data-copy-fallback-label="Link Copied">Copy QR</button>
      <% end %>
      <%= link_to "Open Exam", @take_url, class: "jj-exam-primary" %>
      <small><%= @take_url %></small>
    </div>
  </section>
</main>
