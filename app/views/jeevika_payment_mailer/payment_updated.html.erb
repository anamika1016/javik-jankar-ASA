<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin:0;padding:0;background:#f3f6f4;font-family:Arial,Helvetica,sans-serif;color:#1d2a24;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f6f4;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border:1px solid #dbe5df;border-radius:8px;">
            <% if @test_mode %>
              <tr>
                <td style="padding:10px 24px;background:#fff4d6;color:#7a5a00;font-size:13px;border-radius:8px 8px 0 0;">
                  TEST MAIL - asli recipient: <%= @details[:jj_email].presence || "email saved nahi hai" %>
                </td>
              </tr>
            <% end %>
            <tr>
              <td style="padding:24px 24px 8px;">
                <p style="margin:0 0 4px;font-size:12px;letter-spacing:1px;color:#598f40;font-weight:bold;">JEEVIKA JANKAR PAYMENT</p>
                <h1 style="margin:0;font-size:22px;color:#1d2a24;">Aapki payment update ho gayi hai</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 24px 16px;font-size:15px;line-height:1.5;">
                Namaste <%= @details[:name] %>,<br>
                <%= @details[:bill_month] %> <%= @details[:financial_year] %> ke bill ki Rs. <strong><%= @details[:amount] %></strong> payment
                <strong><%= @details[:transaction_date_label] %></strong> ko <%= @details[:transaction_type] %> dwara bhej di gayi hai.
              </td>
            </tr>
            <tr>
              <td style="padding:0 24px 8px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                  <% [
                       ["Jeevika Jankar ID", @details[:jj_id]],
                       ["Name", @details[:name]],
                       ["Mobile", @details[:mobile_no]],
                       ["Financial Year", @details[:financial_year]],
                       ["Bill Month", @details[:bill_month]],
                       ["Bill ID", @details[:bill_id]],
                       ["Approval Date", @details[:approval_date_label]],
                       ["Amount", "Rs. #{@details[:amount]}"],
                       ["Transaction ID", @details[:transaction_id]],
                       ["Transaction Type", @details[:transaction_type]],
                       ["Transaction Date", @details[:transaction_date_label]],
                       ["Payment Updated On", @details[:updated_at_label]],
                       ["Updated By", @details[:updated_by]]
                     ].each_with_index do |(label, value), index| %>
                    <tr style="background:<%= index.even? ? '#f7faf8' : '#ffffff' %>;">
                      <td style="padding:9px 12px;border-bottom:1px solid #e6ede9;color:#5b6b63;width:45%;"><%= label %></td>
                      <td style="padding:9px 12px;border-bottom:1px solid #e6ede9;font-weight:bold;"><%= value.presence || "-" %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 24px 24px;font-size:12px;color:#7a8a82;line-height:1.5;">
                Ye mail ASA Jeevika Jankar system se automatic bheja gaya hai. Payment se judi kisi jaankari ke liye apne Cluster Coordinator se sampark karein.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
